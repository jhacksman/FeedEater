  "use": {
    "variables": "KIT (this directory), KIT_TOOLS (backfill-capture-kit checkout), ROOT_SPEC, ROOT_COMPOSE_OUT (new directory) are root-supplied; nothing is defaulted",
    "checkKitNoTools": "cd \"$KIT\" && sha256sum -c SHA256SUMS && test \"$(find . -type f | wc -l)\" -eq 14 && test -z \"$(find . -type l)\"",
    "checkKit": "node \"$KIT_TOOLS/check-kit.mjs\" --kit \"$KIT\"",
    "compose": "node \"$KIT/backfill-capture-compose/compose.mjs\" --spec \"$ROOT_SPEC\" --components \"$KIT\" --out \"$ROOT_COMPOSE_OUT\"",
    "afterCompose": "cd \"$ROOT_COMPOSE_OUT\" && export COMPONENTS=\"$KIT\", then run handoff.json commands.rebuildManifest, rebuildPlan, checkContract; capture and verify are root-operated only"
  },
  "rootInputsStillRequired": [
    "ROOT_SPEC (genuine C/H with hashes and times, sourceId, hash/removed evidence, L, caps, window, direct/native filters, clockId and window, subjects)",
    "ROOT_COMPOSE_OUT",
    "ROOT_ENDPOINT and ROOT_CAPTURE_OUT for capture"
  ],
